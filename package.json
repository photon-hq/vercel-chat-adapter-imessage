{
  "name": "chat-adapter-imessage",
  "version": "1.0.0",
  "description": "iMessage adapter for Chat SDK",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "clean": "rm -rf dist coverage"
  },
  "peerDependencies": {
    "chat": "^4.14.0"
  },
  "dependencies": {
    "@chat-adapter/shared": "^4.15.0",
    "mime-types": "^3.0.1",
    "spectrum-ts": "^1.18.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.12",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^4.0.18",
    "chat": "^4.15.0",
    "clean-publish": "^7.0.0",
    "tsup": "^8.3.5",
    "typescript": "^5.9.3",
    "ultracite": "7.8.1",
    "vitest": "^4.0.18"
  },
  "packageManager": "pnpm@10.30.3",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "chat-sdk",
    "chat-adapter",
    "imessage",
    "sms",
    "bot",
    "adapter"
  ],
  "author": "photon",
  "repository": {
    "type": "git",
    "url": "https://github.com/photon-hq/vercel-chat-adapter-imessage.git"
  },
  "homepage": "https://github.com/photon-hq/vercel-chat-adapter-imessage",
  "bugs": {
    "url": "https://github.com/photon-hq/vercel-chat-adapter-imessage/issues"
  },
  "license": "MIT"
}
