{
  "name": "@photon-ai/chat-adapter-imessage",
  "version": "3.0.0",
  "description": "iMessage adapter for Chat SDK",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "clean": "rm -rf dist coverage"
  },
  "peerDependencies": {
    "chat": "^4.14.0"
  },
  "dependencies": {
    "@chat-adapter/shared": "^4.32.0",
    "@spectrum-ts/core": "10.0.0",
    "@spectrum-ts/imessage": "10.0.0",
    "mime-types": "^3.0.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.2",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^22.20.0",
    "@vitest/coverage-v8": "^4.1.9",
    "chat": "^4.32.0",
    "clean-publish": "^7.1.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "ultracite": "7.8.4",
    "vite": "^7.3.6",
    "vitest": "^4.1.9"
  },
  "packageManager": "pnpm@10.30.3",
  "pnpm": {
    "overrides": {
      "esbuild@>=0.27.3 <0.28.1": "^0.28.1",
      "@opentelemetry/core@<2.8.0": "^2.8.0"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "chat-sdk",
    "chat-adapter",
    "imessage",
    "sms",
    "bot",
    "adapter"
  ],
  "author": "photon",
  "repository": {
    "type": "git",
    "url": "https://github.com/photon-hq/vercel-chat-adapter-imessage.git"
  },
  "homepage": "https://github.com/photon-hq/vercel-chat-adapter-imessage",
  "bugs": {
    "url": "https://github.com/photon-hq/vercel-chat-adapter-imessage/issues"
  },
  "license": "MIT"
}
