{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["ultracite/biome/core", "ultracite/biome/vitest"],
  "linter": {
    "rules": {
      "suspicious": {
        "useAwait": "off",
        "noEmptyBlockStatements": "off"
      }
    }
  },
  "files": {
    "includes": ["!dist", "!coverage", "!pnpm-lock.yaml"]
  },
  "overrides": [
    {
      "includes": ["src/index.ts"],
      "linter": {
        "rules": {
          "performance": {
            "noBarrelFile": "off"
          }
        }
      }
    }
  ]
}
